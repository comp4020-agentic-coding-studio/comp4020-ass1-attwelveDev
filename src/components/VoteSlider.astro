---
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---

<!--
  Native range input, not a custom widget — app.ts sets min/max/value and
  aria-valuetext once it knows the scenario's total, so the 0/1/0 here are
  just a valid-markup placeholder until initApp runs.
-->
<label class="vote-slider">
  <span class="vote-slider-label">{label}</span>
  <input type="range" data-slider-for={id} min="0" max="1" value="0" />
</label>
