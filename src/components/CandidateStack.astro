---
import type { CandidateShape } from "../lib/types";

interface Props {
  id: string;
  label: string;
  colour: string;
  shape: CandidateShape;
}
const { id, label, colour, shape } = Astro.props;
---

<div class="candidate-stack" data-candidate={id}>
  <span
    class={`candidate-stack-swatch candidate-stack-swatch-${shape}`}
    style={`--swatch-colour: ${colour};`}
    aria-hidden="true"
  ></span>
  <span class="candidate-stack-label">{label}</span>
  <div class="candidate-stack-bar">
    <div class="candidate-stack-fill" data-fill-for={id} style={`--swatch-colour: ${colour};`}></div>
  </div>
  <span class="candidate-stack-count" data-count-for={id}>0</span>
</div>
